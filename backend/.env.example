# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/unitree

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=3001

# Frontend URL(s) allowed to call the API, comma separated. Leave empty to allow all.
CLIENT_URL=http://localhost:5173

# Accounts with these emails get the admin role on sign up / login, comma separated
ADMIN_EMAILS=you@example.com
